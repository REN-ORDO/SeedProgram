rules_version = '2';

// ============================================================
// Firestore Security Rules — Programa Semilla CooWeb
// ============================================================
// Estrategia:
//   - Las postulaciones (aspirantes / empresas) son CREATE-ONLY
//     desde el cliente público.
//   - Guardas mínimas pero efectivas a nivel rules:
//       * cap de tamaño del doc (anti-spam)
//       * source field obligatorio (anti-bot rudimentario)
//       * serverTimestamp obligatorio (anti-replay con timestamp arbitrario)
//   - Schema validation completo está del lado cliente
//     (ver components/application-form.tsx · validators).
//   - READ, UPDATE y DELETE están denegados desde el cliente:
//     solo se acceden vía Admin SDK (server / Cloud Functions / consola).
//   - Default deny en todo lo demás.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isValidPostulacion() {
      return request.resource.data.size() <= 40
        && request.resource.data.source == 'web-postular'
        && request.resource.data.createdAt == request.time;
    }

    // ---------- Aspirantes (jóvenes postulantes) ----------

    match /aspirantes/{docId} {
      allow create: if isValidPostulacion();
      allow read, update, delete: if false;
    }

    // ---------- Empresas (aliados / patrocinadores) ----------

    match /empresas/{docId} {
      allow create: if isValidPostulacion();
      allow read, update, delete: if false;
    }

    // ---------- Default deny ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
