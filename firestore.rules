rules_version = '2';

// ============================================================
// Firestore Security Rules — Programa Semilla CooWeb
// ============================================================
// Estrategia:
//   - CREATE: cliente público puede crear postulaciones con guardas
//     mínimas (source + serverTimestamp + size cap). El schema lo
//     valida el cliente (ver components/application-form.tsx).
//   - READ / UPDATE: solo admins autenticados (email en ADMIN_EMAILS).
//     Update solo permite cambiar status + updatedAt + updatedBy.
//   - DELETE: bloqueado siempre desde cliente (admin SDK only).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'sg@cooweb.co'
          // agregá más admins acá si hacen falta
        ];
    }

    // Permitir un signin antes de email_verified (para no bloquear admin
    // que recién creó cuenta). Mantiene seguridad porque el email debe
    // estar en la allowlist hardcoded.
    function isAdminEvenUnverified() {
      return request.auth != null
        && request.auth.token.email in [
          'sg@cooweb.co'
        ];
    }

    function isValidPostulacionCreate() {
      return request.resource.data.size() <= 40
        && request.resource.data.source == 'web-postular'
        && request.resource.data.createdAt == request.time;
    }

    // Solo permite update de campos seguros: status, updatedAt, updatedBy.
    // El resto del doc no puede mutarse desde el cliente, ni siquiera por admin.
    function isValidStatusUpdate() {
      let mutated = request.resource.data.diff(resource.data).affectedKeys();
      return mutated.hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['pending', 'reviewed', 'accepted', 'rejected']
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- Aspirantes ----------

    match /aspirantes/{docId} {
      allow create: if isValidPostulacionCreate();
      allow read: if isAdminEvenUnverified();
      allow update: if isAdminEvenUnverified() && isValidStatusUpdate();
      allow delete: if false;
    }

    // ---------- Empresas ----------

    match /empresas/{docId} {
      allow create: if isValidPostulacionCreate();
      allow read: if isAdminEvenUnverified();
      allow update: if isAdminEvenUnverified() && isValidStatusUpdate();
      allow delete: if false;
    }

    // ---------- Default deny ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
